# Copy to .env; the Makefile loads it. Path to the DuckDB file. Leave unset to use the Makefile default
# (<repo>/warehouse/otif.duckdb). If you set it, use an absolute path: the loader
# runs from the repo root and dbt runs from otif_dbt/, so a relative path would
# point them at different files.
# DUCKDB_PATH=/absolute/path/to/warehouse/otif.duckdb
# As-of date for dbt (var run_date). Match the generator end_date so no lines look overdue.
RUN_DATE=2026-10-25
